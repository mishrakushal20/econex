# Copy to .env (or export directly) — never commit real values.

ECONEX_DB_PATH=econex.db

# Razorpay Test Mode. Leave both unset to run in explicit [SIMULATION] mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Leave unset to use the deterministic mock LLM provider (DEMO / SYNTHETIC
# PROVIDER, clearly labelled in the audit trail). Set to enable the real
# Claude strategy classifier.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Unused directly by the server (merchant tokens are seeded per-merchant via
# scripts/seed_demo.py) — present for compatibility/documentation only.
ECONEX_API_TOKEN=demo-merchant-token
